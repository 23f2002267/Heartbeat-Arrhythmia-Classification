adata":{}},{"cell_type":"code","source":"import os\nimport random\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, Dataset, TensorDataset, WeightedRandomSampler\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import f1_score\n\n# ==========================================\n# 1. Setup, Seeding & Data Loading\n# ==========================================\ndef seed_everything(seed=42):\n    random.seed(seed)\n    os.environ['PYTHONHASHSEED'] = str(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(seed)\n\nseed_everything(42)\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"Training on: {device}\")\n\ntrain_df = pd.read_csv('/kaggle/input/competitions/nppe-2-t-2-26-ecg-heartbeat-arrhythmia-classification/nppe2_dataset/train.csv')\ntest_df = pd.read_csv('/kaggle/input/competitions/nppe-2-t-2-26-ecg-heartbeat-arrhythmia-classification/nppe2_dataset/test.csv')\n\nsig_cols = [f'sig_{i}' for i in range(250)]\ntiming_cols = ['pre_rr', 'post_rr', 'rr_ratio']\n\n# ==========================================\n# 2. Preprocessing\n# ==========================================\n# Impute & Scale Timing\nfor col in timing_cols:\n    med = train_df[col].median()\n    train_df[col] = train_df[col].fillna(med)\n    test_df[col] = test_df[col].fillna(med)\n\nscaler = StandardScaler()\ntrain_timings = scaler.fit_transform(train_df[timing_cols].values).astype(np.float32)\ntest_timings = scaler.transform(test_df[timing_cols].values).astype(np.float32)\n\n# Z-Score Normalize Signals\ndef prepare_signals(df):\n    sigs = np.nan_to_num(df[sig_cols].values.astype(np.float32), nan=0.0)\n    mean = np.mean(sigs, axis=1, keepdims=True)\n    std = np.std(sigs, axis=1, keepdims=True) + 1e-8\n    return np.expand_dims((sigs - mean) / std, axis=1)\n\ntrain_signals = prepare_signals(train_df)\ntest_signals = prepare_signals(test_df)\ntrain_labels = train_df['label'].values.astype(np.int64)\n\n# ==========================================\n# 3. Model Architectures\n# ==========================================\n# Model A: Baseline Fusion Net (Used with Sampler)\nclass FusionNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.cnn = nn.Sequential(\n            nn.Conv1d(1, 32, 7, stride=2, padding=3), nn.BatchNorm1d(32), nn.ReLU(),\n            nn.Conv1d(32, 64, 5, stride=2, padding=2), nn.BatchNorm1d(64), nn.ReLU(),\n            nn.Conv1d(64, 128, 3, stride=2, padding=1), nn.BatchNorm1d(128), nn.ReLU(),\n            nn.AdaptiveAvgPool1d(1), nn.Flatten()\n        )\n        self.tab = nn.Sequential(nn.Linear(3, 32), nn.ReLU())\n        self.head = nn.Sequential(nn.Linear(128 + 32, 64), nn.ReLU(), nn.Linear(64, 4))\n    def forward(self, s, t):\n        return self.head(torch.cat([self.cnn(s), self.tab(t)], dim=1))\n\n# Model B: Pure Signal CNN-BiGRU\nclass SignalBiGRUNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.cnn = nn.Sequential(\n            nn.Conv1d(1, 32, 7, stride=2, padding=3), nn.BatchNorm1d(32), nn.ReLU(),\n            nn.Conv1d(32, 64, 5, stride=2, padding=2), nn.BatchNorm1d(64), nn.ReLU()\n        )\n        self.gru = nn.GRU(64, 32, bidirectional=True, batch_first=True)\n        self.head = nn.Linear(64 * 2, 4)\n    def forward(self, s, t=None):\n        out = self.cnn(s).permute(0, 2, 1)\n        out, _ = self.gru(out)\n        avg_pool = torch.mean(out, dim=1)\n        max_pool, _ = torch.max(out, dim=1)\n        return self.head(torch.cat([avg_pool, max_pool], dim=1))\n\n# Model C: Multi-Scale Logit Adjusted\nclass MultiScaleNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.b1 = nn.Sequential(nn.Conv1d(1, 32, 3, padding=1), nn.ReLU(), nn.MaxPool1d(2))\n        self.b2 = nn.Sequential(nn.Conv1d(1, 32, 7, padding=3), nn.ReLU(), nn.MaxPool1d(2))\n        self.mid = nn.Sequential(nn.Conv1d(64, 128, 5, stride=2, padding=2), nn.ReLU(), nn.AdaptiveAvgPool1d(1), nn.Flatten())\n        self.tab = nn.Sequential(nn.Linear(3, 32), nn.ReLU())\n        self.head = nn.Sequential(nn.Linear(128 + 32, 64), nn.Dropout(0.2), nn.Linear(64, 4))\n    def forward(self, s, t):\n        s_feat = self.mid(torch.cat([self.b1(s), self.b2(s)], dim=1))\n        return self.head(torch.cat([s_feat, self.tab(t)], dim=1))\n\nclass LogitAdjustedLoss(nn.Module):\n    def __init__(self, class_counts, tau=0.8):\n        super().__init__()\n        priors = class_counts / np.sum(class_counts)\n        self.adj = torch.tensor(tau * np.log(priors + 1e-12), dtype=torch.float32).to(device)\n    def forward(self, logits, targets):\n        return nn.functional.cross_entropy(logits + self.adj, targets)\n\n# ==========================================\n# 4. Unified 5-Fold Ensemble Training\n# ==========================================\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n\n# Accumulators for Ensembling\ntest_probs_A = np.zeros((len(test_df), 4))\ntest_probs_B = np.zeros((len(test_df), 4))\ntest_probs_C = np.zeros((len(test_df), 4))\n\ntest_dataset = TensorDataset(torch.from_numpy(test_signals).float(), torch.from_numpy(test_timings).float())\ntest_loader = DataLoader(test_dataset, batch_size=512, shuffle=False)\n\nclass_counts = np.bincount(train_labels, minlength=4)\nbase_weights = torch.tensor(np.sqrt(len(train_labels) / class_counts), dtype=torch.float32).to(device)\nlogit_loss = LogitAdjustedLoss(class_counts, tau=0.8)\n\nNUM_EPOCHS = 12\nBATCH_SIZE = 128\n\nfor fold, (t_idx, v_idx) in enumerate(skf.split(train_signals, train_labels)):\n    print(f\"\\n========== ENSEMBLE FOLD {fold + 1} / 5 ==========\")\n    \n    # Dataset Tensors\n    t_sig, t_tab, t_y = torch.from_numpy(train_signals[t_idx]).float(), torch.from_numpy(train_timings[t_idx]).float(), torch.from_numpy(train_labels[t_idx]).long()\n    \n    # Loaders\n    std_loader = DataLoader(TensorDataset(t_sig, t_tab, t_y), batch_size=BATCH_SIZE, shuffle=True)\n    \n    # Sampler loader for Model A\n    counts_f = np.bincount(train_labels[t_idx], minlength=4)\n    sample_weights = (1.0 / counts_f)[train_labels[t_idx]]\n    sampler = WeightedRandomSampler(weights=sample_weights, num_samples=len(sample_weights), replacement=True)\n    samp_loader = DataLoader(TensorDataset(t_sig, t_tab, t_y), batch_size=BATCH_SIZE, sampler=sampler)\n\n    # Initialize Models\n    modA = FusionNet().to(device)\n    modB = SignalBiGRUNet().to(device)\n    modC = MultiScaleNet().to(device)\n\n    optA = optim.AdamW(modA.parameters(), lr=2e-3)\n    optB = optim.AdamW(modB.parameters(), lr=2e-3)\n    optC = optim.AdamW(modC.parameters(), lr=2e-3)\n\n    print(\"Training models...\")\n    for epoch in range(NUM_EPOCHS):\n        # Train Mod A (Sampler)\n        modA.train()\n        for s, t, y in samp_loader:\n            s, t, y = s.to(device), t.to(device), y.to(device)\n            optA.zero_grad()\n            loss = nn.CrossEntropyLoss()(modA(s, t), y)\n            loss.backward()\n            optA.step()\n            \n        # Train Mod B & C (Standard distribution)\n        modB.train(); modC.train()\n        for s, t, y in std_loader:\n            s, t, y = s.to(device), t.to(device), y.to(device)\n            # Mod B\n            optB.zero_grad()\n            lossB = nn.CrossEntropyLoss(weight=base_weights)(modB(s), y)\n            lossB.backward()\n            optB.step()\n            # Mod C\n            optC.zero_grad()\n            lossC = logit_loss(modC(s, t), y)\n            lossC.backward()\n            optC.step()\n\n# Predict on Test Set\n    modA.eval(); modB.eval(); modC.eval()\n    with torch.no_grad():\n        fold_probs_A, fold_probs_B, fold_probs_C = [], [], []\n        \n        for s, t in test_loader:\n            s, t = s.to(device), t.to(device)\n            fold_probs_A.append(torch.softmax(modA(s, t), dim=1).cpu().numpy())\n            fold_probs_B.append(torch.softmax(modB(s), dim=1).cpu().numpy())\n            fold_probs_C.append(torch.softmax(modC(s, t), dim=1).cpu().numpy())\n            \n        test_probs_A += np.vstack(fold_probs_A) / 5.0\n        test_probs_B += np.vstack(fold_probs_B) / 5.0\n        test_probs_C += np.vstack(fold_probs_C) / 5.0\n\n# ==========================================\n# 5. Soft Voting & Final Submission\n# ==========================================\nprint(\"\\nBlending Model Predictions...\")\n# Weight the pure signal model slightly higher to combat tabular domain shift\nblended_probs = (0.30 * test_probs_A) + (0.40 * test_probs_B) + (0.30 * test_probs_C)\n\nfinal_test_preds = np.argmax(blended_probs, axis=1)\n\nprint(\"\\n--- Final Ensemble Test Class Distribution ---\")\nprint(pd.Series(final_test_preds).value_counts(normalize=True).sort_index())\n\nsubmission_df = pd.DataFrame({'id': test_df['id'], 'label': final_test_preds.astype(int)})\nsubmission_df.to_csv('submission.csv', index=False)\nprint(\"\\nsubmission.csv successfully generated using 3-Model Fusion!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-24T06:11:32.776845Z","iopub.execute_input":"2026-08-24T06:11:32.777537Z","iopub.status.idle":"2026-08-24T06:30:37.447634Z","shell.execute_reply.started":"2026-08-24T06:11:32.777495Z","shell.execute_reply":"2026-08-24T06:30:37.446708Z"}},"outputs":[{"name":"stdout","text":"Training on: cuda\n\n========== ENSEMBLE FOLD 1 / 5 ==========\nTraining models...\n\n========== ENSEMBLE FOLD 2 / 5 ==========\nTraining models...\n\n========== ENSEMBLE FOLD 3 / 5 ==========\nTraining models...\n\n========== ENSEMBLE FOLD 4 / 5 ==========\nTraining models...\n\n========== ENSEMBLE FOLD 5 / 5 ==========\nTraining models...\n\nBlending Model Predictions...\n\n--- Final Ensemble Test Class Distribution ---\n0    0.880576\n1    0.022637\n2    0.090170